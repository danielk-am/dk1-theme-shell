		"settings.color.palette[stroke-weak].color": "--wpds-color-stroke-surface-neutral-weak",
		"settings.color.palette[stroke-strong].color": "--wpds-color-stroke-surface-neutral-strong",
		"settings.color.palette[brand].color": "--wpds-color-background-interactive-brand-strong",
