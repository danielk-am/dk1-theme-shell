{
	"$comment": [
		"Every literal in theme.json, and where it comes from in core's design-tokens.css.",
		"A string value asserts equality with that token. A { ratio: [ a, b ] } value asserts",
		"the number equals a / b, which is how a px line-height pair becomes a unitless one.",
		"null means the value is deliberately NOT a token; state why in $unmapped.",
		"tools/check-tokens.mjs fails if any preset is missing from this map, so a new preset",
		"cannot be added without saying what it is."
	],
	"$unmapped": {
		"settings.typography.fontSizes[display].size": "A hero's one display size, above the 2xl the WPDS scale stops at. Fluid, 36px to 54px. Public sites' heroes (asiamannequin, themannequinshop, frozenmeat) all sat at 32px and read as body-sized; no token to mirror.",
		"settings.spacing.spacingSizes[80].size": "48px, twice the XL step. WPDS stops at gap-3xl (40px); page level rhythm needs one more rung and inventing it here is more honest than bending a token to fit.",
		"settings.color.palette[accent].color": "A brand's second colour, as text on ink or as a rule. WPDS has no accent role and the base has no second colour, so it equals brand until a site binds it; it is a core-block preset only, with no token to mirror.",
		"settings.color.palette[chrome].color": "A site's header/footer bar colour, distinct from neutral-strong (which stays the system's dark ink fill and dark solid-button colour). No token behind it: core-block preset only, so it reaches core blocks, not wpds blocks. Equals brand until a child theme binds it."
	},
	"map": {
