		"settings.color.palette[base-strong].color": "--wpds-color-background-surface-neutral-strong",
		"settings.color.palette[base-weak].color": "--wpds-color-background-surface-neutral-weak",
		"settings.color.palette[contrast].color": "--wpds-color-foreground-content-neutral",
		"settings.color.palette[contrast-weak].color": "--wpds-color-foreground-content-neutral-weak",
