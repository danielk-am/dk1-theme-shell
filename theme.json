{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "960px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"slug": "base",
					"name": "Surface",
					"color": "#fcfcfc"
				},
				{
					"slug": "base-strong",
					"name": "Surface strong",
					"color": "#ffffff"
				},
				{
					"slug": "base-weak",
					"name": "Surface weak",
					"color": "#f4f4f4"
				},
				{
					"slug": "contrast",
					"name": "Content",
					"color": "#1e1e1e"
				},
				{
					"slug": "contrast-weak",
					"name": "Content weak",
					"color": "#707070"
				},
				{
					"slug": "stroke",
					"name": "Stroke",
					"color": "#dbdbdb"
				},
				{
					"slug": "stroke-weak",
					"name": "Stroke weak",
					"color": "#f0f0f0"
				},
				{
					"slug": "stroke-strong",
					"name": "Stroke strong",
					"color": "#8d8d8d"
				},
				{
					"slug": "brand",
					"name": "Brand",
					"color": "#3858e9"
				},
				{
					"slug": "brand-pressed",
					"name": "Brand pressed",
					"color": "#2e49d9"
				},
				{
					"slug": "brand-on",
					"name": "On brand",
					"color": "#eff0f2"
				},
				{
					"slug": "brand-surface",
					"name": "Brand surface",
					"color": "#ecf0fa"
				},
				{
					"slug": "brand-content",
					"name": "Brand content",
					"color": "#3858e9"
				},
				{
					"slug": "accent",
					"name": "Accent",
					"color": "#3858e9"
				},
				{
					"slug": "chrome",
					"name": "Chrome",
					"color": "#3858e9"
				},
				{
					"slug": "neutral-strong",
					"name": "Neutral strong",
					"color": "#2d2d2d"
				},
				{
					"slug": "success",
					"name": "Success",
					"color": "#008030"
				},
				{
					"slug": "success-surface",
					"name": "Success surface",
					"color": "#c6f7cd"
				},
				{
					"slug": "info",
					"name": "Info",
					"color": "#006bd7"
				},
				{
					"slug": "info-surface",
					"name": "Info surface",
					"color": "#deebfa"
				},
				{
					"slug": "warning",
					"name": "Warning",
					"color": "#926300"
				},
				{
					"slug": "warning-surface",
					"name": "Warning surface",
					"color": "#fde6be"
				},
				{
					"slug": "error",
					"name": "Error",
					"color": "#cc1818"
				},
				{
					"slug": "error-surface",
					"name": "Error surface",
					"color": "#f6e6e3"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": false,
			"writingMode": true,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "System",
					"fontFamily": "-apple-system, system-ui, \"Segoe UI\", \"Roboto\", \"Oxygen-Sans\", \"Ubuntu\", \"Cantarell\", \"Helvetica Neue\", sans-serif"
				},
				{
					"slug": "heading",
					"name": "Heading",
					"fontFamily": "-apple-system, system-ui, \"Segoe UI\", \"Roboto\", \"Oxygen-Sans\", \"Ubuntu\", \"Cantarell\", \"Helvetica Neue\", sans-serif"
				},
				{
					"slug": "mono",
					"name": "Monospace",
					"fontFamily": "\"Menlo\", \"Consolas\", monaco, monospace"
				}
			],
			"fontSizes": [
				{
					"slug": "x-small",
					"name": "XS",
					"size": "11px"
				},
				{
					"slug": "small",
					"name": "S",
					"size": "12px"
				},
				{
					"slug": "medium",
					"name": "M",
					"size": "13px"
				},
				{
					"slug": "large",
					"name": "L",
					"size": "15px"
				},
				{
					"slug": "x-large",
					"name": "XL",
					"size": "20px"
				},
				{
					"slug": "xx-large",
					"name": "2XL",
					"size": "32px"
				},
				{
					"slug": "display",
					"name": "Display",
					"size": "clamp(2.25rem, 1.5rem + 2.5vw, 3.4rem)"
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [
				"px",
				"%",
				"rem",
				"em",
				"vh",
				"vw"
			],
			"spacingSizes": [
				{
					"slug": "10",
					"name": "XS",
					"size": "4px"
				},
				{
					"slug": "20",
					"name": "S",
					"size": "8px"
				},
				{
					"slug": "30",
					"name": "M",
					"size": "12px"
				},
				{
					"slug": "40",
					"name": "L",
					"size": "16px"
				},
				{
					"slug": "50",
					"name": "XL",
					"size": "24px"
				},
				{
					"slug": "60",
					"name": "2XL",
					"size": "32px"
				},
				{
					"slug": "70",
					"name": "3XL",
					"size": "40px"
				},
				{
					"slug": "80",
					"name": "4XL",
					"size": "48px"
				}
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": []
		},
		"background": {
			"backgroundImage": true,
			"backgroundSize": true
		},
		"dimensions": {
			"aspectRatio": true,
			"minHeight": true
		},
		"position": {
			"fixed": true,
			"sticky": true
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "400",
			"lineHeight": "1.538462"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--40)",
			"padding": {
				"top": "0",
				"bottom": "0",
				"left": "0",
				"right": "0"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wpds-color-foreground-interactive-brand, var(--wp--preset--color--brand))"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var(--wpds-color-foreground-interactive-brand-active, #0b0070)"
					},
					"typography": {
						"textDecoration": "underline"
					}
				},
				":focus": {
					"color": {
						"text": "var(--wpds-color-foreground-interactive-brand-active, #0b0070)"
					}
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "600"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"lineHeight": "1.25"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"lineHeight": "1.2"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"lineHeight": "1.333333"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"lineHeight": "1.538462"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"lineHeight": "1.538462"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-small)",
					"lineHeight": "1.454545",
					"textTransform": "uppercase"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--brand)",
					"text": "var(--wp--preset--color--brand-on)"
				},
				"border": {
					"color": "var(--wp--preset--color--brand)",
					"radius": "2px",
					"style": "solid",
					"width": "1px"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--10)",
						"bottom": "var(--wp--preset--spacing--10)",
						"left": "var(--wp--preset--spacing--30)",
						"right": "var(--wp--preset--spacing--30)"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "600",
					"lineHeight": "1.538462",
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--brand-pressed)",
						"text": "var(--wp--preset--color--brand-on)"
					},
					"border": {
						"color": "var(--wp--preset--color--brand-pressed)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--brand-pressed)",
						"text": "var(--wp--preset--color--brand-on)"
					},
					"border": {
						"color": "var(--wp--preset--color--brand-pressed)"
					},
					"outline": {
						"color": "var(--wp--preset--color--brand)",
						"offset": "1px",
						"style": "solid",
						"width": "2px"
					}
				},
				":active": {
					"color": {
						"background": "var(--wp--preset--color--brand-pressed)",
						"text": "var(--wp--preset--color--brand-on)"
					},
					"border": {
						"color": "var(--wp--preset--color--brand-pressed)"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--contrast-weak)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"lineHeight": "1.333333"
				}
			}
		},
		"blocks": {
			"core/code": {
				"color": {
					"background": "var(--wp--preset--color--base-weak)",
					"text": "var(--wp--preset--color--contrast)"
				},
				"border": {
					"color": "var(--wp--preset--color--stroke)",
					"radius": "4px",
					"style": "solid",
					"width": "1px"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--30)",
						"bottom": "var(--wp--preset--spacing--30)",
						"left": "var(--wp--preset--spacing--30)",
						"right": "var(--wp--preset--spacing--30)"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"lineHeight": "1.333333"
				}
			},
			"core/preformatted": {
				"color": {
					"background": "var(--wp--preset--color--base-weak)",
					"text": "var(--wp--preset--color--contrast)"
				},
				"border": {
					"color": "var(--wp--preset--color--stroke)",
					"radius": "4px",
					"style": "solid",
					"width": "1px"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--30)",
						"bottom": "var(--wp--preset--spacing--30)",
						"left": "var(--wp--preset--spacing--30)",
						"right": "var(--wp--preset--spacing--30)"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"lineHeight": "1.333333"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var(--wp--preset--color--stroke)",
						"style": "solid",
						"width": "4px"
					}
				},
				"spacing": {
					"padding": {
						"left": "var(--wp--preset--spacing--40)"
					}
				}
			},
			"core/pullquote": {
				"border": {
					"color": "var(--wp--preset--color--stroke)",
					"style": "solid",
					"width": "1px 0"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--50)",
						"bottom": "var(--wp--preset--spacing--50)"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"lineHeight": "1.6"
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--stroke)"
				}
			},
			"core/site-title": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "600",
					"lineHeight": "1.333333",
					"textDecoration": "none"
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"typography": {
								"textDecoration": "underline"
							}
						}
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"fontWeight": "600",
					"lineHeight": "1.25"
				}
			},
			"core/post-date": {
				"color": {
					"text": "var(--wp--preset--color--contrast-weak)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "400"
				},
				"spacing": {
					"blockGap": "var(--wp--preset--spacing--40)"
				}
			},
			"core/table": {
				"border": {
					"color": "var(--wp--preset--color--stroke)",
					"style": "solid",
					"width": "1px"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)"
				}
			},
			"core/heading": {
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"typography": {
								"textDecoration": "underline"
							}
						}
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "admin-header",
			"title": "Admin page header",
			"area": "header"
		},
		{
			"name": "app-sidebar",
			"title": "App sidebar",
			"area": "uncategorized"
		},
		{
			"name": "admin-header-index",
			"title": "Admin page header (index)",
			"area": "header"
		},
		{
			"name": "admin-header-archive",
			"title": "Admin page header (archive)",
			"area": "header"
		},
		{
			"name": "admin-header-search",
			"title": "Admin page header (search)",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "blank",
			"title": "Blank canvas",
			"postTypes": [
				"page",
				"post"
			]
		},
		{
			"name": "content-page",
			"title": "Content page",
			"postTypes": [
				"page",
				"post"
			]
		}
	]
}
